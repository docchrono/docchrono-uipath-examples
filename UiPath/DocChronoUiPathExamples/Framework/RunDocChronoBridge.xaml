  <Sequence DisplayName="Run DocChrono bridge" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <ui:LogMessage DisplayName="Log bridge request start" Level="Info">
      <ui:LogMessage.Message>
        <InArgument x:TypeArguments="x:Object">["Starting DocChrono request " &amp; Path.GetFileName(in_RequestPath)]</InArgument>
      </ui:LogMessage.Message>
    </ui:LogMessage>
    <ui:InvokeCode
      Code="out_Stdout = String.Empty&#xA;out_Stderr = String.Empty&#xA;out_ExitCode = -1&#xA;out_TimedOut = False&#xA;&#xA;If in_TimeoutMs &lt;= 0 Then&#xA;    Throw New ArgumentOutOfRangeException(&quot;in_TimeoutMs&quot;)&#xA;End If&#xA;&#xA;Dim resolvedWorkingDirectory = Path.GetFullPath(in_WorkingDirectory)&#xA;Dim resolvedPythonExecutable = If(Path.IsPathRooted(in_PythonExe), in_PythonExe, Path.GetFullPath(Path.Combine(resolvedWorkingDirectory, in_PythonExe)))&#xA;Dim responseDirectory = Path.GetDirectoryName(in_ResponsePath)&#xA;If Not String.IsNullOrWhiteSpace(responseDirectory) Then&#xA;    Directory.CreateDirectory(responseDirectory)&#xA;End If&#xA;If File.Exists(in_ResponsePath) Then&#xA;    File.Delete(in_ResponsePath)&#xA;End If&#xA;&#xA;Dim startInfo As New ProcessStartInfo()&#xA;startInfo.FileName = resolvedPythonExecutable&#xA;startInfo.WorkingDirectory = resolvedWorkingDirectory&#xA;startInfo.UseShellExecute = False&#xA;startInfo.CreateNoWindow = True&#xA;startInfo.RedirectStandardOutput = True&#xA;startInfo.RedirectStandardError = True&#xA;startInfo.ArgumentList.Add(&quot;-m&quot;)&#xA;startInfo.ArgumentList.Add(&quot;docchrono_uipath_bridge&quot;)&#xA;startInfo.ArgumentList.Add(&quot;--request&quot;)&#xA;startInfo.ArgumentList.Add(in_RequestPath)&#xA;startInfo.ArgumentList.Add(&quot;--response&quot;)&#xA;startInfo.ArgumentList.Add(in_ResponsePath)&#xA;&#xA;Using bridgeProcess As New Process()&#xA;    bridgeProcess.StartInfo = startInfo&#xA;    If Not bridgeProcess.Start() Then&#xA;        Throw New InvalidOperationException(&quot;The DocChrono bridge process did not start.&quot;)&#xA;    End If&#xA;&#xA;    Dim stdoutTask = bridgeProcess.StandardOutput.ReadToEndAsync()&#xA;    Dim stderrTask = bridgeProcess.StandardError.ReadToEndAsync()&#xA;&#xA;    If Not bridgeProcess.WaitForExit(in_TimeoutMs) Then&#xA;        out_TimedOut = True&#xA;        Try&#xA;            bridgeProcess.Kill(True)&#xA;        Catch&#xA;            bridgeProcess.Kill()&#xA;        End Try&#xA;        bridgeProcess.WaitForExit()&#xA;    End If&#xA;&#xA;    out_Stdout = stdoutTask.GetAwaiter().GetResult()&#xA;    out_Stderr = stderrTask.GetAwaiter().GetResult()&#xA;    If Not out_TimedOut Then&#xA;        out_ExitCode = bridgeProcess.ExitCode&#xA;    End If&#xA;End Using"
      ContinueOnError="{x:Null}"
      DisplayName="Launch isolated Python bridge"
      Language="VBNet">
      <ui:InvokeCode.Arguments>
