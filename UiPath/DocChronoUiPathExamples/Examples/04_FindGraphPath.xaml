<Activity mc:Ignorable="sap sap2010" x:Class="Examples_04_FindGraphPath" mva:VisualBasic.Settings="{x:Null}"
  xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:mva="clr-namespace:Microsoft.VisualBasic.Activities;assembly=System.Activities"
  xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
  xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
  xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib"
  xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib"
  xmlns:ui="http://schemas.uipath.com/workflow/activities"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_PythonExe" Type="InArgument(x:String)" />
    <x:Property Name="in_WorkingDirectory" Type="InArgument(x:String)" />
    <x:Property Name="out_ResponsePath" Type="OutArgument(x:String)" />
  </x:Members>
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System</x:String>
      <x:String>System.Activities</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.IO</x:String>
      <x:String>Microsoft.VisualBasic</x:String>
      <x:String>UiPath.Core</x:String>
      <x:String>UiPath.Core.Activities</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>System.Private.CoreLib</AssemblyReference>
      <AssemblyReference>System</AssemblyReference>
      <AssemblyReference>Microsoft.VisualBasic</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="Example 4 - Find evidence graph path" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:Int32" Name="bridgeExitCode" />
    </Sequence.Variables>
    <Assign x:TypeArguments="x:String" DisplayName="Set graph-path response path">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[out_ResponsePath]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[Path.Combine(in_WorkingDirectory, "artifacts", "responses", "04_find_path.response.json")]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:InvokeWorkflowFile DisplayName="Run graph-path bridge request" WorkflowFileName="Framework\RunDocChronoBridge.xaml" UnSafe="False">
      <ui:InvokeWorkflowFile.Arguments>
        <scg:Dictionary x:TypeArguments="x:String, Argument">
          <InArgument x:TypeArguments="x:String" x:Key="in_PythonExe">[in_PythonExe]</InArgument>
          <InArgument x:TypeArguments="x:String" x:Key="in_WorkingDirectory">[in_WorkingDirectory]</InArgument>
          <InArgument x:TypeArguments="x:String" x:Key="in_RequestPath">[Path.Combine(in_WorkingDirectory, "Examples", "requests", "04_find_path.json")]</InArgument>
          <InArgument x:TypeArguments="x:String" x:Key="in_ResponsePath">[out_ResponsePath]</InArgument>
          <InArgument x:TypeArguments="x:Int32" x:Key="in_TimeoutMs">[60000]</InArgument>
          <OutArgument x:TypeArguments="x:String" x:Key="out_Stdout" />
          <OutArgument x:TypeArguments="x:String" x:Key="out_Stderr" />
          <OutArgument x:TypeArguments="x:Int32" x:Key="out_ExitCode">[bridgeExitCode]</OutArgument>
          <OutArgument x:TypeArguments="x:Boolean" x:Key="out_TimedOut" />
        </scg:Dictionary>
      </ui:InvokeWorkflowFile.Arguments>
    </ui:InvokeWorkflowFile>
    <ui:LogMessage DisplayName="Log graph-path outcome" Level="Info">
      <ui:LogMessage.Message>
        <InArgument x:TypeArguments="x:Object">["Example 4 found a validated evidence path with stored direction retained. Exit=" &amp; bridgeExitCode.ToString() &amp; "; response=" &amp; Path.GetFileName(out_ResponsePath)]</InArgument>
      </ui:LogMessage.Message>
    </ui:LogMessage>
  </Sequence>
</Activity>
